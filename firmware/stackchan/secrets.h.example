#pragma once
// Copy this file to secrets.h (same folder) and fill in the practice Wi-Fi.
// secrets.h is gitignored — never commit a real SSID or password.
//
// PlatformIO / Arduino: #include "secrets.h" from the sketch.

#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_SSID"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "YOUR_PASSWORD"
#endif

// Optional shared token. If non-empty, Suite must send the same value in
// the X-StackChan-Token header (and ?token= on GET helpers). Leave empty
// for a first-night LAN demo on a trusted practice network.
#ifndef STACKCHAN_TOKEN
#define STACKCHAN_TOKEN ""
#endif

#ifndef STACKCHAN_HOSTNAME
#define STACKCHAN_HOSTNAME "stackchan"
#endif

#ifndef STACKCHAN_HTTP_PORT
#define STACKCHAN_HTTP_PORT 80
#endif
